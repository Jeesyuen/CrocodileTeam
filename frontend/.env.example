# Optional: API origin when the frontend is not served behind the same host/proxy as the backend.
# Leave empty in development (Vite proxies /api, /uploads and /ws to http://127.0.0.1:8000).
VITE_API_URL=

# Optional raster tile server for the demo map (defaults to OpenStreetMap's public tiles, light use only).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
