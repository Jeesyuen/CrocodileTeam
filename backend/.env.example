# Copy to backend/.env and adjust.

# SQLite (default, zero setup) or PostgreSQL/PostGIS:
# DATABASE_URL=postgresql+psycopg://saferoute:saferoute@localhost:5432/saferoute
# DATABASE_URL defaults to backend/saferoute.db (SQLite)

# Use a long random value in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hazard photo analysis via Claude. Server-side only — never put this in the frontend.
# Leave empty to run without AI (users classify hazards manually).
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5

# Google Maps base map + Places search (optional). Browser key — it is sent to signed-in users,
# so in Google Cloud restrict it to HTTP referrers (your site) and to "Maps JavaScript API" +
# "Places API (New)". Leave empty to use the Leaflet / OpenStreetMap demo map.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID for Advanced Markers and cloud styling; DEMO_MAP_ID is used if empty (development only).
GOOGLE_MAPS_MAP_ID=

# Demo mode enables the demo-account picker and the operator "Reset demo data" action.
DEMO_MODE=true
